<Window x:Class="SeniorCtzz.Adminpensionlist"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OSCA(SECTION) - Pension List" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"  WindowState="Maximized"  Background="#F5F5F5">

    <Window.Resources>
 
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#B71C1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="Foreground" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#FFCDD2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding SelectionBoxItem}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="#111827" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="▾" FontSize="10" Foreground="#6B7280"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.ColumnSpan="2"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Opacity="0"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                            CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" Margin="0,2,0,0">
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,8,12,8"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- RED SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B71C1C" Offset="0"/>
                    <GradientStop Color="#7F0000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="Black"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,20" HorizontalAlignment="Center">
                    <Border Width="62" Height="62" CornerRadius="31" Background="White"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <TextBlock Text="RR" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B71C1C"/>
                    </Border>
                    <TextBlock Text="Daisy Jane R. Acero" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="White"/>
                    <Border Background="White" CornerRadius="10" Padding="10,3"
                            HorizontalAlignment="Center" Margin="0,4,0,20">
                        <TextBlock Text="Section Head" FontSize="10" Foreground="#B71C1C" HorizontalAlignment="Center"/>
                    </Border>
                    <Button Content="  DASHBOARD" Style="{StaticResource NavButtonStyle}" Click="BtnDashboard_Click"/>
                    <Button Content="  Staff Accounts" Style="{StaticResource NavButtonStyle}" Click="BtnManageStaff_Click"/>
                    <Button Content="  Pension List" Style="{StaticResource NavButtonActiveStyle}"/>
                    <Button Content="  Reports" Style="{StaticResource NavButtonStyle}" Click="BtnReports_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20">
                    <Button Content="Logout" Style="{StaticResource LogoutButtonStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
                <StackPanel/>
            </DockPanel>
        </Border>

  
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="28,14,28,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Pension List" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="View pension records by category" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="btnBrgList"   Content="Barangay List" Style="{StaticResource TabButtonActiveStyle}" Click="BtnBrgList_Click"/>
                    <Button x:Name="btnQuarterly" Content="Quarterly"     Style="{StaticResource TabButtonStyle}"       Click="BtnQuarterly_Click"/>
                    <Button x:Name="btnAICS"      Content="AICS"          Style="{StaticResource TabButtonStyle}"       Click="BtnAICS_Click"/>
                    <Button x:Name="btnAPR"       Content="APR"           Style="{StaticResource TabButtonStyle}"       Click="BtnAPR_Click"/>
                    <Button x:Name="btnBereaved"  Content="BEREAVED"      Style="{StaticResource TabButtonStyle}"       Click="BtnBereaved_Click"/>
                </StackPanel>

                <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="10" Padding="14,10,14,10" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblFilterLabel" Text="LIST OF SENIOR CITIZENS"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#374151"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbBarangay" Style="{StaticResource ComboStyle}"
                                  Width="170" Margin="0,0,10,0" SelectionChanged="Filter_SelectionChanged"/>
                        <TextBlock Text="AS OF:" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbAsOf" Style="{StaticResource ComboStyle}"
                                  Width="140" SelectionChanged="Filter_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                
                        <Border x:Name="pnlBrgList" Visibility="Visible" Background="White"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgBrgList" Style="{StaticResource ReportGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="50"/>
                                    <DataGridTextColumn Header="LAST NAME" Binding="{Binding LastName}" Width="*"/>
                                    <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                                    <DataGridTextColumn Header="MIDDLE NAME" Binding="{Binding MiddleName}" Width="*"/>
                                    <DataGridTextColumn Header="SUFFIX" Binding="{Binding Suffix}" Width="55"/>
                                    <DataGridTextColumn Header="SEX" Binding="{Binding Sex}" Width="44"/>
                                    <DataGridTextColumn Header="BIRTH DATE" Binding="{Binding BirthDate}" Width="90"/>
                                    <DataGridTextColumn Header="AGE" Binding="{Binding Age}" Width="44"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="65"/>
                                    <DataGridTextColumn Header="OSCA I.D." Binding="{Binding OscaId}" Width="80"/>
                                    <DataGridTextColumn Header="DATE ISSUED" Binding="{Binding DateIssued}" Width="95"/>
                                    <DataGridTextColumn Header="BLOOD TYPE" Binding="{Binding BloodType}" Width="80"/>
                                    <DataGridTextColumn Header="LGU" Binding="{Binding Lgu}" Width="55"/>
                                    <DataGridTextColumn Header="DSWD" Binding="{Binding Dswd}" Width="55"/>
                                    <DataGridTextColumn Header="WAITLIST" Binding="{Binding Waitlist}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                   
                        <Border x:Name="pnlQuarterly" Visibility="Collapsed" Background="White"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="dgQuarterly" Grid.Row="0" Style="{StaticResource ReportGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="50"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="95"/>
                                        <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                                        <DataGridTextColumn Header="LAST NAME" Binding="{Binding LastName}" Width="*"/>
                                        <DataGridTextColumn Header="BARANGAY" Binding="{Binding Brgy}" Width="90"/>
                                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="90"/>
                                        <DataGridTextColumn Header="RELEASE DATE" Binding="{Binding ReleaseDate}" Width="100"/>
                                        <DataGridTemplateColumn Header="STATUS" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Padding="8,3"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="{Binding StatusBg}"
                                                            BorderBrush="{Binding StatusBorder}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusFg}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TOTAL" FontWeight="Bold" Width="400"
                                                   Foreground="#111827" FontSize="13"/>
                                        <TextBlock x:Name="txtQuarterlyTotal" Text="0"
                                                   FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                    
                        <Border x:Name="pnlAICS" Visibility="Collapsed" Background="White"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="dgAICS" Grid.Row="0" Style="{StaticResource ReportGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="50"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="110"/>
                                        <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                                        <DataGridTextColumn Header="LAST NAME" Binding="{Binding LastName}" Width="*"/>
                                        <DataGridTextColumn Header="BARANGAY" Binding="{Binding Brgy}" Width="90"/>
                                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TOTAL" FontWeight="Bold" Width="400"
                                                   Foreground="#111827" FontSize="13"/>
                                        <TextBlock x:Name="txtAICSTotal" Text="0"
                                                   FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                   
                        <Border x:Name="pnlAPR" Visibility="Collapsed" Background="White"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="dgAPR" Grid.Row="0" Style="{StaticResource ReportGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="50"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="110"/>
                                        <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                                        <DataGridTextColumn Header="LAST NAME" Binding="{Binding LastName}" Width="*"/>
                                        <DataGridTextColumn Header="BARANGAY" Binding="{Binding Brgy}" Width="90"/>
                                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TOTAL" FontWeight="Bold" Width="400"
                                                   Foreground="#111827" FontSize="13"/>
                                        <TextBlock x:Name="txtAPRTotal" Text="0"
                                                   FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                     
                        <Border x:Name="pnlBereaved" Visibility="Collapsed" Background="White"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="dgBereaved" Grid.Row="0" Style="{StaticResource ReportGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="50"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="95"/>
                                        <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                                        <DataGridTextColumn Header="LAST NAME" Binding="{Binding LastName}" Width="*"/>
                                        <DataGridTextColumn Header="BARANGAY" Binding="{Binding Brgy}" Width="80"/>
                                        <DataGridTextColumn Header="RECIPIENT NAME" Binding="{Binding RecipientName}" Width="160"/>
                                        <DataGridTextColumn Header="RELATIONSHIP" Binding="{Binding Relationship}" Width="130"/>
                                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="90"/>
                                        <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TOTAL" FontWeight="Bold" Width="760"
                                                   Foreground="#111827" FontSize="13"/>
                                        <TextBlock x:Name="txtBereavedTotal" Text="0"
                                                   FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
