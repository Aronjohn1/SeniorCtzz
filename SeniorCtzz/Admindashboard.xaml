<Window x:Class="SeniorCtzz.Admindashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeniorCtzz"
        mc:Ignorable="d"
        Title="Section Head - Dashboard" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"  WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#F8F4F4">

    <Window.Resources>

      
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FECACA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="6,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9B1C1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

     
        <Style x:Key="NavButtonActiveStyle" TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F1D1D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

 
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="Foreground" Value="#BE123C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE4E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

     
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16,18,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                      Opacity="0.07" Color="#7F1D1D"/>
                </Setter.Value>
            </Setter>
        </Style>

    
        <Style x:Key="StatCardAccentStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16,18,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3"
                                      Opacity="0.20" Color="#7F1D1D"/>
                </Setter.Value>
            </Setter>
        </Style>

     
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1C1917"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6B4B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10,0,0,10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

      
        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0,10,10,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="DashboardColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,11,14,11"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

     
        <Style x:Key="DashboardCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

 
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7F1D1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

   
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#7F1D1D" Offset="0"/>
                    <GradientStop Color="#991B1B" Offset="0.5"/>
                    <GradientStop Color="#B91C1C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                  Opacity="0.20" Color="#7F1D1D"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

         
                <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                            Margin="16,30,16,22">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="#9B1C1C"
                            BorderBrush="#9B1C1C" BorderThickness="2.5"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0"
                                              Opacity="0.35" Color="#7F1D1D"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtAvatar" Text="RR"
                                   FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TxtUserName" Text="Daisy Jane R. Acero"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,6"/>

                    <Border HorizontalAlignment="Center" CornerRadius="12"
                            Background="White" Padding="14,3,14,3">
                        <TextBlock x:Name="TxtRole" Text="Section Head"
                                   FontSize="10" Foreground="Black"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

         
                <StackPanel Grid.Row="1" Margin="14,0,14,0" VerticalAlignment="Top">
                    <Button Content="   Dashboard"
                            Style="{StaticResource NavButtonActiveStyle}"
                            Click="BtnDashboard_Click"/>
                    <Button Content="   Staff Accounts"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnManageStaff_Click"/>
                    <Button Content="   Pension List"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnPensionList_Click"/>
                    <Button Content="   Reports"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnReports_Click"/>
                </StackPanel>

                <!-- Logout -->
                <StackPanel Grid.Row="2" Margin="14,0,14,20">
                    <Button Content="Logout"
                            Style="{StaticResource LogoutButtonStyle}"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

     
        <Grid Grid.Column="1" Background="#F8F4F4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

 
            <Border Grid.Row="0" Background="White" Padding="28,14,28,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.06" Color="#7F1D1D"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold"
                                   Foreground="#1C0A0A"/>
                        <TextBlock Text="Overview of the Senior Citizens Pension Program."
                                   FontSize="11" Foreground="#9F5050" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="10" Background="#FEF2F2"
                            Padding="14,8,14,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentDate" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#991B1B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

       
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="28,22,28,28">
                <StackPanel>

                  
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatCardAccentStyle}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#991B1B" Offset="0"/>
                                    <GradientStop Color="#B91C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Senior Citizens"
                                               FontSize="11" Foreground="#FECACA" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtTotalSC" FontSize="32"
                                               FontWeight="Bold" Foreground="White">
                                        <Run Text="0"/>
                                    </TextBlock>
                                    <TextBlock Text="All registered records"
                                               FontSize="10" Foreground="#FCA5A5" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44"
                                        CornerRadius="12" Background="#FFFFFF22"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Active Seniors"
                                               FontSize="11" Foreground="#78716C" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtTotalActive" FontSize="32"
                                               FontWeight="Bold" Foreground="#1C0A0A">
                                        <Run Text="0"/>
                                    </TextBlock>
                                    <TextBlock Text="Currently enrolled"
                                               FontSize="10" Foreground="#A8A29E" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Inactive Seniors"
                                               FontSize="11" Foreground="#78716C" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtTotalInactive" FontSize="32"
                                               FontWeight="Bold" Foreground="#1C0A0A">
                                        <Run Text="0"/>
                                    </TextBlock>
                                    <TextBlock Text="No longer active"
                                               FontSize="10" Foreground="#A8A29E" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

               
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="AICS" FontSize="11"
                                           Foreground="#78716C" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtTotalAICS" FontSize="28"
                                           FontWeight="Bold" Foreground="#991B1B">
                                    <Run Text="0"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="APR" FontSize="11"
                                           Foreground="#78716C" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtTotalAPR" FontSize="28"
                                           FontWeight="Bold" Foreground="#991B1B">
                                    <Run Text="0"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Quarterly" FontSize="11"
                                           Foreground="#78716C" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtTotalQuarterly" FontSize="28"
                                           FontWeight="Bold" Foreground="#991B1B">
                                    <Run Text="0"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Bereaved" FontSize="11"
                                           Foreground="#78716C" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtTotalBereaved" FontSize="28"
                                           FontWeight="Bold" Foreground="#991B1B">
                                    <Run Text="0"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

              
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Staff Encoders"
                                           FontSize="11" Foreground="#78716C" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtTotalStaff" FontSize="28"
                                           FontWeight="Bold" Foreground="#1C0A0A">
                                    <Run Text="0"/>
                                </TextBlock>
                                <TextBlock Text="Active accounts"
                                           FontSize="10" Foreground="#A8A29E" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Entries This Month"
                                           FontSize="11" Foreground="#78716C" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtEntriesMonth" FontSize="28"
                                           FontWeight="Bold" Foreground="#1C0A0A">
                                    <Run Text="0"/>
                                </TextBlock>
                                <TextBlock Text="New registrations"
                                           FontSize="10" Foreground="#A8A29E" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Releases This Month"
                                           FontSize="11" Foreground="#78716C" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtReleasesMonth" FontSize="28"
                                           FontWeight="Bold" Foreground="#1C0A0A">
                                    <Run Text="0"/>
                                </TextBlock>
                                <TextBlock Text="Pension releases"
                                           FontSize="10" Foreground="#A8A29E" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                 
                    <TextBlock Text="Search Senior Citizen" FontSize="13"
                               FontWeight="SemiBold" Foreground="#1C0A0A" Margin="0,0,0,4"/>
                    <TextBlock Text="Search by last name or OSCA I.D." FontSize="11"
                               Foreground="#9F5050" Margin="0,0,0,8"/>
                    <Grid Width="380" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Grid.Column="0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource SearchButtonStyle}"
                                Click="BtnSearch_Click">
                            <TextBlock Text="🔍" FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border x:Name="SearchDropdown" Width="380" HorizontalAlignment="Left"
                            Background="White" BorderBrush="#FECDD3" BorderThickness="1"
                            CornerRadius="10" Margin="0,0,0,20" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                              Opacity="0.08" Color="#7F1D1D"/>
                        </Border.Effect>
                        <ListBox x:Name="SearchResultList" BorderThickness="0"
                                 Background="Transparent" FontSize="12" MaxHeight="140"
                                 SelectionChanged="SearchResultList_SelectionChanged"/>
                    </Border>

             
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Senior Citizens Pension Summary"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#1C0A0A" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Border CornerRadius="12" Background="#DBEAFE"
                                    Padding="10,3,10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRecordCount" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#1D4ED8"
                                           Text="0 records"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="lblSearchInfo" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,8"
                               Visibility="Collapsed"/>

              
                    <Border Background="White" BorderBrush="#93C5FD"
                            BorderThickness="1.5" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                              Opacity="0.08" Color="#3B82F6"/>
                        </Border.Effect>
                        <DataGrid x:Name="dgRecent"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFF"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  VerticalGridLinesBrush="#E2E8F0"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single"
                                  FontSize="12"
                                  RowHeight="38"
                                  ColumnHeaderStyle="{StaticResource DashboardColumnHeaderStyle}"
                                  CellStyle="{StaticResource DashboardCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE (REG.)"
                                                    Binding="{Binding Date}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="LAST NAME"
                                                    Binding="{Binding LastName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="FIRST NAME"
                                                    Binding="{Binding FirstName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="BARANGAY"
                                                    Binding="{Binding Barangay}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="AICS"
                                                    Binding="{Binding AICSCount}"
                                                    Width="60"/>
                                <DataGridTextColumn Header="APR"
                                                    Binding="{Binding APRCount}"
                                                    Width="60"/>
                                <DataGridTextColumn Header="QUARTERLY"
                                                    Binding="{Binding QuarterlyCount}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="BEREAVED"
                                                    Binding="{Binding BereavedCount}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="TOTAL"
                                                    Binding="{Binding TotalPensions}"
                                                    Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
