<Window x:Class="SeniorCtzz.Staffpensionlist"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeniorCtzz"
        mc:Ignorable="d"
        Title="Staff Encoder - Pension List" Height="680" Width="1200"
        WindowStartupLocation="CenterScreen"  WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#F9FAFB">

    <Window.Resources>
        <!-- Nav Button - BLUE SIDEBAR -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Button - WHITE/BLACK -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding SelectionBoxItem}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="#111827" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="▾" FontSize="10" Foreground="#6B7280"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.ColumnSpan="2"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Opacity="0"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}" Margin="0,2,0,0">
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BLUE SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="16,28,16,20">
                    <Border Width="60" Height="60" CornerRadius="30" Background="White"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtAvatar" Text="RR" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1E3A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtUserName" Text="Jonil P. Sanchez" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,2"/>
                    <Border Background="#DBEAFE" CornerRadius="10" Padding="10,3"
                            HorizontalAlignment="Center" Margin="0,4,0,20">
                        <TextBlock Text="Staff Encoder" FontSize="10" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="16,0,16,0" VerticalAlignment="Top">
                    <Button Content="DASHBOARD"    Style="{StaticResource NavButtonStyle}"        Click="BtnDashboard_Click"/>
                    <Button Content="Register"     Style="{StaticResource NavButtonStyle}"        Click="BtnRegister_Click"/>
                    <Button Content="Release"      Style="{StaticResource NavButtonStyle}"        Click="BtnAAB_Click"/>
                    <Button Content="Pension List"  Style="{StaticResource NavButtonActiveStyle}" Click="BtnPensionList_Click"/>
                    <Button Content="Reports"      Style="{StaticResource NavButtonStyle}"        Click="BtnReports_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="16,0,16,20">
                    <Button Content="Logout" Style="{StaticResource LogoutButtonStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="#F9FAFB">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="28,24,28,0">
                <TextBlock Text="Pension List" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="BtnTabBarangay"  Content="Barangay List" Style="{StaticResource TabButtonActiveStyle}" Click="BtnTabBarangay_Click"/>
                    <Button x:Name="BtnTabQuarterly" Content="Quarterly"     Style="{StaticResource TabButtonStyle}"       Click="BtnTabQuarterly_Click"/>
                    <Button x:Name="BtnTabAICS"      Content="AICS"          Style="{StaticResource TabButtonStyle}"       Click="BtnTabAICS_Click"/>
                    <Button x:Name="BtnTabAPR"       Content="APR"           Style="{StaticResource TabButtonStyle}"       Click="BtnTabAPR_Click"/>
                    <Button x:Name="BtnTabBereaved"  Content="BEREAVED"      Style="{StaticResource TabButtonStyle}"       Click="BtnTabBereaved_Click"/>
                </StackPanel>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblFilterLabel" Text="LIST OF SENIOR CITIZEN'S BARANGAY:"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#374151"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbBarangayFilter" Style="{StaticResource ComboStyle}"
                                  Width="170" Margin="0,0,20,0" SelectionChanged="Filter_SelectionChanged"/>
                        <TextBlock Text="AS OF:" FontSize="11" FontWeight="SemiBold" Foreground="#374151"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbAsOf" Style="{StaticResource ComboStyle}"
                                  Width="140" SelectionChanged="Filter_SelectionChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- BARANGAY LIST -->
            <Border x:Name="PanelBarangayList" Grid.Row="1" Margin="28,0,28,20"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Visibility="Visible">
                <DataGrid x:Name="DgBarangayList" Style="{StaticResource GridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NO"          Binding="{Binding No}"         Width="40"/>
                        <DataGridTextColumn Header="LAST NAME"   Binding="{Binding LastName}"   Width="*"/>
                        <DataGridTextColumn Header="FIRST NAME"  Binding="{Binding FirstName}"  Width="*"/>
                        <DataGridTextColumn Header="MIDDLE NAME" Binding="{Binding MiddleName}" Width="*"/>
                        <DataGridTextColumn Header="SUFFIX"      Binding="{Binding Suffix}"     Width="55"/>
                        <DataGridTextColumn Header="SEX"         Binding="{Binding Sex}"        Width="45"/>
                        <DataGridTextColumn Header="BIRTH DATE"  Binding="{Binding BirthDate}"  Width="90"/>
                        <DataGridTextColumn Header="AGE"         Binding="{Binding Age}"        Width="45"/>
                        <DataGridTextColumn Header="STATUS"      Binding="{Binding Status}"     Width="70"/>
                        <DataGridTextColumn Header="OSCA I.D."   Binding="{Binding OscaId}"     Width="110"/>
                        <DataGridTextColumn Header="DATE ISSUED" Binding="{Binding DateIssued}" Width="95"/>
                        <DataGridTextColumn Header="BLOOD TYPE"  Binding="{Binding BloodType}"  Width="80"/>
                        <DataGridTextColumn Header="LGU"         Binding="{Binding LGU}"        Width="50"/>
                        <DataGridTextColumn Header="DSWD"        Binding="{Binding DSWD}"       Width="55"/>
                        <DataGridTextColumn Header="SSS"         Binding="{Binding Sss}"        Width="50"/>
                        <DataGridTextColumn Header="GSIS"        Binding="{Binding Gsis}"       Width="55"/>
                        <DataGridTextColumn Header="WAITLIST"    Binding="{Binding Waitlist}"   Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- QUARTERLY -->
            <Border x:Name="PanelQuarterlyTab" Grid.Row="1" Margin="28,0,28,20"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                <DataGrid x:Name="DgQuarterlyList" Style="{StaticResource GridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True" ColumnWidth="*">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="OSCA ID"      Binding="{Binding OscaId}"      Width="*"/>
                        <DataGridTextColumn Header="Full Name"    Binding="{Binding FullName}"    Width="2*"/>
                        <DataGridTextColumn Header="Date"         Binding="{Binding Date}"        Width="*"/>
                        <DataGridTextColumn Header="Barangay"     Binding="{Binding Barangay}"    Width="*"/>
                        <DataGridTextColumn Header="Amount"       Binding="{Binding Amount}"      Width="*"/>
                        <DataGridTextColumn Header="Release Date" Binding="{Binding ReleaseDate}" Width="*"/>
                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding StatusBg}"
                                            BorderBrush="{Binding StatusBorder}" BorderThickness="1">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusFg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- AICS -->
            <Border x:Name="PanelAICSTab" Grid.Row="1" Margin="28,0,28,20"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                <DataGrid x:Name="DgAICSList" Style="{StaticResource GridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NO"         Binding="{Binding No}"        Width="40"/>
                        <DataGridTextColumn Header="DATE"       Binding="{Binding Date}"      Width="95"/>
                        <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                        <DataGridTextColumn Header="LAST NAME"  Binding="{Binding LastName}"  Width="*"/>
                        <DataGridTextColumn Header="BARANGAY"   Binding="{Binding Brgy}"      Width="120"/>
                        <DataGridTextColumn Header="AMOUNT"     Binding="{Binding Amount}"    Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- APR -->
            <Border x:Name="PanelAPRTab" Grid.Row="1" Margin="28,0,28,20"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                <DataGrid x:Name="DgAPRList" Style="{StaticResource GridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NO"         Binding="{Binding No}"        Width="40"/>
                        <DataGridTextColumn Header="DATE"       Binding="{Binding Date}"      Width="95"/>
                        <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                        <DataGridTextColumn Header="LAST NAME"  Binding="{Binding LastName}"  Width="*"/>
                        <DataGridTextColumn Header="BARANGAY"   Binding="{Binding Brgy}"      Width="120"/>
                        <DataGridTextColumn Header="AMOUNT"     Binding="{Binding Amount}"    Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- BEREAVED -->
            <Border x:Name="PanelBereavedTab" Grid.Row="1" Margin="28,0,28,20"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                <DataGrid x:Name="DgBereavedTab" Style="{StaticResource GridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NO"           Binding="{Binding No}"            Width="35"/>
                        <DataGridTextColumn Header="DATE"         Binding="{Binding Date}"          Width="85"/>
                        <DataGridTextColumn Header="FIRST NAME"   Binding="{Binding FirstName}"     Width="*"/>
                        <DataGridTextColumn Header="LAST NAME"    Binding="{Binding LastName}"      Width="*"/>
                        <DataGridTextColumn Header="BARANGAY"     Binding="{Binding Brgy}"          Width="100"/>
                        <DataGridTextColumn Header="RECIPIENT"    Binding="{Binding RecipientName}" Width="140"/>
                        <DataGridTextColumn Header="RELATIONSHIP" Binding="{Binding Relationship}"  Width="110"/>
                        <DataGridTextColumn Header="AMOUNT"       Binding="{Binding Amount}"        Width="80"/>
                        <DataGridTextColumn Header="REMARKS"      Binding="{Binding Remarks}"       Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>