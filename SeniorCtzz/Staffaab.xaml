<Window x:Class="SeniorCtzz.Staffaab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeniorCtzz"
        mc:Ignorable="d"
        Title="Staff Encoder - AICS, APR, BEREAVED, QPL" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"  WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#F9FAFB">
    <Window.Resources>
        <!-- Nav Button - BLUE SIDEBAR -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tab Button - WHITE/BLACK -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="16,0,16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="20,0,20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding SelectionBoxItem}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="#111827" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="▾" FontSize="10" Foreground="#6B7280"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.ColumnSpan="2"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Opacity="0"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}" Margin="0,2,0,0">
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8,10,8"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- BLUE SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="16,28,16,20">
                    <Border Width="60" Height="60" CornerRadius="30" Background="White"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtAvatar" Text="RR" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1E3A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtUserName" Text="Jonil P. Sanchez" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,2"/>
                    <Border Background="#DBEAFE" CornerRadius="10" Padding="10,3"
                            HorizontalAlignment="Center" Margin="0,4,0,20">
                        <TextBlock Text="Staff Encoder" FontSize="10" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="16,0,16,0" VerticalAlignment="Top">
                    <Button Content="DASHBOARD"    Style="{StaticResource NavButtonStyle}"       Click="BtnDashboard_Click"/>
                    <Button Content="Register"     Style="{StaticResource NavButtonStyle}"       Click="BtnRegister_Click"/>
                    <Button Content="Release"      Style="{StaticResource NavButtonActiveStyle}" Click="BtnAAB_Click"/>
                    <Button Content="Pension List" Style="{StaticResource NavButtonStyle}"       Click="BtnPensionList_Click"/>
                    <Button Content="Reports"      Style="{StaticResource NavButtonStyle}"       Click="BtnReports_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="16,0,16,20">
                    <Button Content="⎋  Logout" Style="{StaticResource LogoutButtonStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F9FAFB">
            <StackPanel Margin="40,28,40,28">
                <TextBlock Text="Release" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,24"/>

                <!-- TAB BUTTONS -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Button x:Name="BtnTabAICS"      Content="AICS"      Style="{StaticResource TabButtonActiveStyle}" Click="BtnTabAICS_Click"/>
                    <Button x:Name="BtnTabAPR"       Content="APR"       Style="{StaticResource TabButtonStyle}"       Click="BtnTabAPR_Click"/>
                    <Button x:Name="BtnTabBereaved"  Content="BEREAVED"  Style="{StaticResource TabButtonStyle}"       Click="BtnTabBereaved_Click"/>
                    <Button x:Name="BtnTabQuarterly" Content="Quarterly" Style="{StaticResource TabButtonStyle}"       Click="BtnTabQuarterly_Click"/>
                </StackPanel>

                <!-- ===== AICS / APR PANEL ===== -->
                <StackPanel x:Name="PanelAICS_APR" Visibility="Visible">
                    <TextBlock x:Name="TxtPanelLabel" Text="AICS — Assistance to Indigent Senior Citizens"
                               FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,14"/>

                    <!-- Search -->
                    <TextBlock Text="Search by Name" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                    <Grid Width="320" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearchAAB" Grid.Column="0" Height="36" FontSize="13"
                                 BorderBrush="#D1D5DB" BorderThickness="1,1,0,1"
                                 Padding="10,0,10,0" VerticalContentAlignment="Center"
                                 Background="White" TextChanged="TxtSearchAAB_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8,0,0,8">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource SearchButtonStyle}" Click="BtnSearchAAB_Click">
                            <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Button>
                    </Grid>
                    <Border x:Name="SearchDropdownAAB" Width="320" HorizontalAlignment="Left"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,20" Visibility="Collapsed">
                        <ListBox x:Name="SearchResultAAB" BorderThickness="0" Background="Transparent"
                                 FontSize="12" MaxHeight="100" SelectionChanged="SearchResultAAB_SelectionChanged"/>
                    </Border>

                    <!-- AICS-only fields: Hospital Bill / 30% / Total -->
                    <Grid Margin="0,0,0,16" x:Name="GridAICSFields">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hospital Bill" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtHospitalBill" Style="{StaticResource InputStyle}" TextChanged="TxtHospitalBill_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="30% Assistance" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="Txt30Percent" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Total Amount" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtAmountAAB" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <!-- APR-only fields: Fixed Amount only (no hospital bill) -->
                    <Grid Margin="0,0,0,16" x:Name="GridAPRField" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fixed Amount" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtAPRAmount" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold" Text="5,000">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <!-- Shared: Date / Full Name / Barangay -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DATE" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtBirthDateAAB" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtFullNameAAB" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="BARANGAY" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtBarangayAAB" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="BtnSaveAAB_Click"/>
                    </StackPanel>

                    <!-- Error -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="8" Padding="12,10,12,10" Margin="0,12,0,0" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=TxtErrorAAB}" Value="Visible">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=TxtErrorAAB}" Value="Collapsed">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " FontSize="13" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtErrorAAB" Foreground="#DC2626" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== BEREAVED PANEL ===== -->
                <StackPanel x:Name="PanelBereaved" Visibility="Collapsed">
                    <TextBlock Text="BEREAVED" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>
                    <TextBlock Text="Search by Name" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                    <Grid Width="320" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearchBereaved" Grid.Column="0" Height="36" FontSize="13"
                                 BorderBrush="#D1D5DB" BorderThickness="1,1,0,1"
                                 Padding="10,0,10,0" VerticalContentAlignment="Center" Background="White"
                                 TextChanged="TxtSearchBereaved_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8,0,0,8">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource SearchButtonStyle}" Click="BtnSearchBereaved_Click">
                            <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Button>
                    </Grid>
                    <Border x:Name="SearchDropdownBereaved" Width="320" HorizontalAlignment="Left"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,20" Visibility="Collapsed">
                        <ListBox x:Name="SearchResultBereaved" BorderThickness="0" Background="Transparent"
                                 FontSize="12" MaxHeight="100" SelectionChanged="SearchResultBereaved_SelectionChanged"/>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BIRTH DATE" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtBirthDateBereaved" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtFullNameBereaved" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="BARANGAY" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtBarangayBereaved" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fixed Amount" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtAmountBereaved" Height="40" FontSize="13" Foreground="#111827"
                                     Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                     Padding="12,0,12,0" VerticalContentAlignment="Center"
                                     IsEnabled="False" FontWeight="SemiBold" Text="2,000">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Recipient Name (Family Member)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtRecipientName" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Relationship to Deceased" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtRelationship" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Remarks (Optional)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtRemarksBereaved" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="BtnSaveBereaved_Click"/>
                    </StackPanel>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="8" Padding="12,10,12,10" Margin="0,12,0,0" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=TxtErrorBereaved}" Value="Visible">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=TxtErrorBereaved}" Value="Collapsed">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " FontSize="13" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtErrorBereaved" Foreground="#DC2626" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== QUARTERLY PANEL ===== -->
                <StackPanel x:Name="PanelQuarterly" Visibility="Collapsed">
                    <TextBlock Text="Quarterly Pension Release" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Search by Name" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchQuarterly" Grid.Column="0" Height="36" FontSize="13"
                                         BorderBrush="#D1D5DB" BorderThickness="1,1,0,1"
                                         Padding="10,0,10,0" VerticalContentAlignment="Center" Background="White"
                                         TextChanged="TxtSearchQuarterly_TextChanged">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8,0,0,8">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource SearchButtonStyle}" Click="BtnSearchQuarterly_Click">
                                    <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Filter by Barangay" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbQuarterlyBarangay" Style="{StaticResource ComboStyle}"
                                      SelectionChanged="CmbQuarterlyBarangay_SelectionChanged">
                                <ComboBoxItem Content="All Barangays" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="BtnPending"  Content="Pending"  Width="100" Style="{StaticResource TabButtonActiveStyle}" Click="BtnPending_Click"/>
                        <Button x:Name="BtnUpcoming" Content="Upcoming" Width="100" Style="{StaticResource TabButtonStyle}"       Click="BtnUpcoming_Click"/>
                        <Button x:Name="BtnRelease"  Content="Released" Width="100" Style="{StaticResource TabButtonStyle}"       Click="BtnRelease_Click"/>
                    </StackPanel>
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                        <DataGrid x:Name="DgQuarterly" Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" ColumnWidth="*">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="OSCA ID"      Binding="{Binding OscaId}"      Width="*"/>
                                <DataGridTextColumn Header="Full Name"    Binding="{Binding FullName}"    Width="2*"/>
                                <DataGridTextColumn Header="Date"         Binding="{Binding Date}"        Width="*"/>
                                <DataGridTextColumn Header="Barangay"     Binding="{Binding Barangay}"    Width="*"/>
                                <DataGridTextColumn Header="Amount"       Binding="{Binding Amount}"      Width="*"/>
                                <DataGridTextColumn Header="Release Date" Binding="{Binding ReleaseDate}" Width="*"/>
                                <DataGridTemplateColumn Header="Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding StatusBg}"
                                                    BorderBrush="{Binding StatusBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusFg}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
