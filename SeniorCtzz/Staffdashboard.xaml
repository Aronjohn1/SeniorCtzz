<Window x:Class="SeniorCtzz.Staffdashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeniorCtzz"
        Title="Staff Encoder - Dashboard" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"  WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#F9FAFB">

    <Window.Resources>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,14,20,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,0,0,8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="DashboardCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

  
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP: Avatar + Role -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="16,28,16,20">
                    <Border Width="60" Height="60" CornerRadius="30"
                            Background="White" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtAvatar" Text="SJ" FontSize="18"
                                   FontWeight="SemiBold" Foreground="#1E3A8A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtUserName" Text="Jonil P. Sanchez" FontSize="13"
                               FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,2"/>
                    <Border Background="#DBEAFE" CornerRadius="10" Padding="10,3"
                            HorizontalAlignment="Center" Margin="0,4,0,20">
                        <TextBlock Text="Staff Encoder" FontSize="10" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

      
                <StackPanel Grid.Row="1" Margin="16,0,16,0" VerticalAlignment="Top">
                    <Button Content="DASHBOARD"   Style="{StaticResource NavButtonActiveStyle}" Click="BtnDashboard_Click"/>
                    <Button Content="Register"    Style="{StaticResource NavButtonStyle}"       Click="BtnRegister_Click"/>
                    <Button Content="Release"     Style="{StaticResource NavButtonStyle}"       Click="BtnAAB_Click"/>
                    <Button Content="Pension List" Style="{StaticResource NavButtonStyle}"      Click="BtnPensionType_Click"/>
                    <Button Content="Reports"     Style="{StaticResource NavButtonStyle}"       Click="BtnReports_Click"/>
                </StackPanel>

         
                <StackPanel Grid.Row="2" Margin="16,0,16,20">
                    <Button Content="Logout" Style="{StaticResource LogoutButtonStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

 
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F9FAFB">
            <StackPanel Margin="32,28,32,28">

                <TextBlock Text="DASHBOARD" FontSize="24" FontWeight="Bold"
                           Foreground="#111827" Margin="0,0,0,24"/>

         
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Total Active Seniors" FontSize="11" Foreground="#6B7280" Margin="0,12,0,8"/>
                            <TextBlock x:Name="TxtTotalSeniors" FontSize="28" FontWeight="Bold" Foreground="#111827"><Run Text="0"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="AICS" FontSize="11" Foreground="#6B7280" Margin="0,12,0,8"/>
                            <TextBlock x:Name="TxtTotalAICS" FontSize="28" FontWeight="Bold" Foreground="#111827"><Run Text="0"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="APR" FontSize="11" Foreground="#6B7280" Margin="0,12,0,8"/>
                            <TextBlock x:Name="TxtTotalAPR" FontSize="28" FontWeight="Bold" Foreground="#111827"><Run Text="0"/></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

        
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="BEREAVED" FontSize="11" Foreground="#6B7280" Margin="0,12,0,8"/>
                            <TextBlock x:Name="TxtTotalBereaved" FontSize="28" FontWeight="Bold" Foreground="#111827"><Run Text="0"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Quarterly" FontSize="11" Foreground="#6B7280" Margin="0,12,0,8"/>
                            <TextBlock x:Name="TxtTotalQuarterly" FontSize="28" FontWeight="Bold" Foreground="#111827"><Run Text="0"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Inactive Seniors" FontSize="11" Foreground="#6B7280" Margin="0,12,0,8"/>
                            <TextBlock x:Name="TxtTotalInactive" FontSize="28" FontWeight="Bold" Foreground="#111827"><Run Text="0"/></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

     
                <TextBlock Text="Search by Last or OSCA I.D." FontSize="12" FontWeight="SemiBold"
           Foreground="#374151" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,4" Width="340" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearch" Grid.Column="0" Style="{StaticResource SearchBoxStyle}"
             TextChanged="TxtSearch_TextChanged"/>
                    <Button Grid.Column="1" Style="{StaticResource SearchButtonStyle}" Click="BtnSearch_Click">
                        <TextBlock Text="🔍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="White"/>
                    </Button>
                </Grid>
                <Border x:Name="SearchDropdown" Width="340" HorizontalAlignment="Left"
        Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
        CornerRadius="8" Margin="0,0,0,16" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <ListBox x:Name="SearchResultList" BorderThickness="0" Background="Transparent"
             FontSize="12" MaxHeight="120" SelectionChanged="SearchResultList_SelectionChanged"/>
                </Border>

      
                <TextBlock Text="Senior Citizens Pension Summary" FontSize="14" FontWeight="Bold"
           Foreground="#111827" Margin="0,0,0,10"/>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                    </Border.Effect>
                    <DataGrid x:Name="DgRecent"
              AutoGenerateColumns="False" IsReadOnly="True"
              BorderThickness="0" Background="White"
              RowBackground="White" AlternatingRowBackground="#F9FAFB"
              GridLinesVisibility="All"
              HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#D1D5DB"
              HeadersVisibility="Column" CanUserResizeRows="False"
              CanUserReorderColumns="False" SelectionMode="Single"
              FontSize="12" RowHeight="38"
              ColumnHeaderStyle="{StaticResource DashboardColumnHeaderStyle}"
              CellStyle="{StaticResource DashboardCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE (REG.)" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="LAST NAME" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="BARANGAY" Binding="{Binding Barangay}" Width="100"/>
                            <DataGridTextColumn Header="AICS" Binding="{Binding AICSCount}" Width="60"/>
                            <DataGridTextColumn Header="APR" Binding="{Binding APRCount}" Width="60"/>
                            <DataGridTextColumn Header="QUARTERLY" Binding="{Binding QuarterlyCount}" Width="80"/>
                            <DataGridTextColumn Header="BEREAVED" Binding="{Binding BereavedCount}" Width="80"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPensions}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
