<Window x:Class="SeniorCtzz.Adminreports"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OSCA(SECTION) - Reports" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"    WindowState="Maximized" Background="#F5F5F5">

    <Window.Resources>

     
        <Style x:Key="SideNavStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideNavActiveStyle" TargetType="Button" BasedOn="{StaticResource SideNavStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#B71C1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="Foreground" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#FFCDD2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="MainTabStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabActiveStyle" TargetType="Button" BasedOn="{StaticResource MainTabStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
        </Style>

        <Style x:Key="SubTabStyle" TargetType="Button" BasedOn="{StaticResource MainTabStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SubTabActiveStyle" TargetType="Button" BasedOn="{StaticResource SubTabStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
        </Style>


        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding SelectionBoxItem}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="#111827" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="▾" FontSize="10" Foreground="#6B7280"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.ColumnSpan="2"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Opacity="0"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}" Margin="0,2,0,0">
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

   
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D1D5DB"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeaderStyle}"/>
        </Style>

      
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

    
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B71C1C" Offset="0"/>
                    <GradientStop Color="#7F0000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="Black"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,20" HorizontalAlignment="Center">
                    <Border Width="62" Height="62" CornerRadius="31" Background="White"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <TextBlock x:Name="txtInitials" Text="RR" FontSize="20" FontWeight="Bold" Foreground="#B71C1C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="txtUserName" Text="Daisy Jane R. Acero" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="White"/>
                    <Border Background="White" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" Margin="0,4,0,20">
                        <TextBlock x:Name="txtUserRole" Text="Section Head" FontSize="10" Foreground="#B71C1C" HorizontalAlignment="Center"/>
                    </Border>
                    <Button Content=" DASHBOARD"   Style="{StaticResource SideNavStyle}" Click="BtnDashboard_Click"/>
                    <Button Content="  Staff Accounts" Style="{StaticResource SideNavStyle}" Click="BtnManageStaff_Click"/>
                    <Button Content="  Pension List"  Style="{StaticResource SideNavStyle}" Click="BtnPensionList_Click"/>
                    <Button Content="  Reports"       Style="{StaticResource SideNavActiveStyle}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20">
                    <Button Content="Logout" Style="{StaticResource LogoutButtonStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
                <StackPanel/>
            </DockPanel>
        </Border>


        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,18,28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reports" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="TxtSubtitle" Text="Barangay List" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <TextBlock x:Name="TxtDateBadge" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

      
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,16,28,0">
                <Button x:Name="btnBarangayList" Content="BARANGAY LIST" Style="{StaticResource MainTabActiveStyle}" Click="BtnBarangayList_Click"/>
                <Button x:Name="btnOverAllSC"    Content="OVER-ALL SC"   Style="{StaticResource MainTabStyle}"       Click="BtnOverAllSC_Click"/>
                <Button x:Name="btnPension"      Content="PENSION"       Style="{StaticResource MainTabStyle}"       Click="BtnPension_Click"/>
            </StackPanel>

         
            <Border x:Name="pnlPensionSubTabs" Grid.Row="2" Margin="28,10,28,0" Visibility="Collapsed"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="10,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnAll"      Content="ALL"      Style="{StaticResource SubTabActiveStyle}" Click="BtnAll_Click"/>
                    <Button x:Name="btnQuarterly" Content="Quarterly" Style="{StaticResource SubTabStyle}"      Click="BtnQuarterly_Click"/>
                    <Button x:Name="btnAICS"     Content="AICS"     Style="{StaticResource SubTabStyle}"       Click="BtnAICSReport_Click"/>
                    <Button x:Name="btnAPR"      Content="APR"      Style="{StaticResource SubTabStyle}"       Click="BtnAPR_Click"/>
                    <Button x:Name="btnBereaved" Content="BEREAVED" Style="{StaticResource SubTabStyle}" Margin="0" Click="BtnBereaved_Click"/>
                </StackPanel>
            </Border>

 
            <ScrollViewer Grid.Row="3" Margin="28,14,28,14" VerticalScrollBarVisibility="Auto">
                <Grid>

            
                    <StackPanel x:Name="pnlBarangayList" Visibility="Visible">
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIST OF SENIOR CITIZEN'S BARANGAY:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#374151" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbReportBarangay" Width="170" Style="{StaticResource ComboStyle}"
                                          Margin="0,0,20,0" SelectionChanged="FilterReport_SelectionChanged"/>
                                <TextBlock Text="AS OF:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#374151" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbReportAsOf" Width="140" Style="{StaticResource ComboStyle}"
                                          SelectionChanged="FilterReport_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                            <DataGrid x:Name="dgBarangayList" Style="{StaticResource GridStyle}" HorizontalAlignment="Stretch">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NO"          Binding="{Binding No}"         Width="40"/>
                                    <DataGridTextColumn Header="LAST NAME"   Binding="{Binding LastName}"   Width="*"/>
                                    <DataGridTextColumn Header="FIRST NAME"  Binding="{Binding FirstName}"  Width="*"/>
                                    <DataGridTextColumn Header="MIDDLE NAME" Binding="{Binding MiddleName}" Width="*"/>
                                    <DataGridTextColumn Header="SUFFIX"      Binding="{Binding Suffix}"     Width="55"/>
                                    <DataGridTextColumn Header="SEX"         Binding="{Binding Sex}"        Width="45"/>
                                    <DataGridTextColumn Header="BIRTH DATE"  Binding="{Binding BirthDate}"  Width="90"/>
                                    <DataGridTextColumn Header="AGE"         Binding="{Binding Age}"        Width="45"/>
                                    <DataGridTextColumn Header="STATUS"      Binding="{Binding Status}"     Width="60"/>
                                    <DataGridTextColumn Header="OSCA I.D."   Binding="{Binding OscaId}"     Width="100"/>
                                    <DataGridTextColumn Header="DATE ISSUED" Binding="{Binding DateIssued}" Width="95"/>
                                    <DataGridTextColumn Header="BLOOD TYPE"  Binding="{Binding BloodType}"  Width="80"/>
                                    <DataGridTextColumn Header="LGU"         Binding="{Binding Lgu}"        Width="50"/>
                                    <DataGridTextColumn Header="DSWD"        Binding="{Binding Dswd}"       Width="55"/>
                                    <DataGridTextColumn Header="SSS"         Binding="{Binding Sss}"        Width="50"/>
                                    <DataGridTextColumn Header="GSIS"        Binding="{Binding Gsis}"       Width="55"/>
                                    <DataGridTextColumn Header="WAITLIST"    Binding="{Binding Waitlist}"   Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

      
                    <StackPanel x:Name="pnlOverAllSC" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                          
                                <Border Grid.Row="0" CornerRadius="0" Margin="0,0,0,10" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#1E3A8A">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="REPUBLIC OF THE PHILIPPINES"  FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="PROVINCE OF MISAMIS ORIENTAL" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Background="#B91C1C" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" Background="White"
                                                        Margin="8,0,16,0" VerticalAlignment="Center" BorderBrush="#FCD34D" BorderThickness="2">
                                                    <Image Source="/Assets/logo1.png" Width="68" Height="68"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="GINGOOG CITY" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="CITY SOCIAL WELFARE &amp; DEVELOPMENT OFFICE"
                                                               FontSize="11" Foreground="#FCD34D" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                          
                                <Border Grid.Row="1" Background="White" BorderBrush="#374151" BorderThickness="2" CornerRadius="4" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Background="White" Padding="0,14" BorderBrush="#374151" BorderThickness="0,0,0,2">
                                            <TextBlock x:Name="txtOverAllTitle" FontSize="12" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                        </Border>

                                  
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="White"   BorderBrush="#9CA3AF" BorderThickness="0,0,1,1" Padding="4,10">
                                                <TextBlock Text="NO."      FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#111827"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="White"   BorderBrush="#9CA3AF" BorderThickness="0,0,1,1" Padding="4,10">
                                                <TextBlock Text="BARANGAY" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#111827"/>
                                            </Border>
                                            <Border Grid.Column="2" Background="#EAB308" BorderBrush="#9CA3AF" BorderThickness="0,0,1,1" Padding="4,10">
                                                <TextBlock Text="NATIONAL PENSIONER" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#1C1917"/>
                                            </Border>
                                            <Border Grid.Column="3" Background="#22C55E" BorderBrush="#9CA3AF" BorderThickness="0,0,1,1" Padding="4,10">
                                                <TextBlock Text="LOCAL PENSIONER" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="4" Background="#FCA5A5" BorderBrush="#9CA3AF" BorderThickness="0,0,1,1" Padding="4,10">
                                                <TextBlock Text="WAITLIST" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#7F1D1D"/>
                                            </Border>
                                            <Border Grid.Column="5" Background="#22C55E" BorderBrush="#9CA3AF" BorderThickness="0,0,1,1" Padding="4,10">
                                                <TextBlock Text="SSS"  FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="6" Background="#22C55E" BorderBrush="#9CA3AF" BorderThickness="0,0,1,1" Padding="4,10">
                                                <TextBlock Text="GSIS" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="7" Background="#93C5FD" BorderBrush="#9CA3AF" BorderThickness="0,0,0,1" Padding="4,10">
                                                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#1E3A8A"/>
                                            </Border>
                                        </Grid>

                              
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"  Background="White"   BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7"/>
                                            <Border Grid.Column="1"  Background="White"   BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7"/>
                                            <Border Grid.Column="2"  Background="#FEF08A" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="MALE"   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#713F12"/>
                                            </Border>
                                            <Border Grid.Column="3"  Background="#FEF08A" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="FEMALE" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#713F12"/>
                                            </Border>
                                            <Border Grid.Column="4"  Background="#86EFAC" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="MALE"   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="5"  Background="#86EFAC" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="FEMALE" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="6"  Background="#FECACA" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="MALE"   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#7F1D1D"/>
                                            </Border>
                                            <Border Grid.Column="7"  Background="#FECACA" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="FEMALE" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#7F1D1D"/>
                                            </Border>
                                            <Border Grid.Column="8"  Background="#86EFAC" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="MALE"   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="9"  Background="#86EFAC" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="FEMALE" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="10" Background="#86EFAC" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="MALE"   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="11" Background="#86EFAC" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="FEMALE" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#14532D"/>
                                            </Border>
                                            <Border Grid.Column="12" Background="#BFDBFE" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="2,7">
                                                <TextBlock Text="MALE"   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E3A8A"/>
                                            </Border>
                                            <Border Grid.Column="13" Background="#BFDBFE" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="2,7">
                                                <TextBlock Text="FEMALE" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E3A8A"/>
