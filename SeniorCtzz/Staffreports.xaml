                                    <DataGridTextColumn Header="AMOUNT"     Binding="{Binding Amount}"    Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="0,0,10,10" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total" FontWeight="Bold" Foreground="#111827" Width="420"/>
                                <TextBlock x:Name="txtAPRTotal" FontWeight="Bold" Foreground="#111827" FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PREPARED BY:" Style="{StaticResource SigLabelStyle}"/>
                                    <TextBlock x:Name="TxtAPRSigPreparedName" Style="{StaticResource SigNameStyle}"/>
                                    <TextBlock Text="ENCODER" Style="{StaticResource SigTitleStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="NOTED BY:" Style="{StaticResource SigLabelStyle}"/>
                                    <TextBlock Text="DAISY JANE R. ACERO, RSW"
                                               Style="{StaticResource SigNameStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="SWO-III/ SC-Focal Person"
                                               Style="{StaticResource SigTitleStyle}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

             
                    <StackPanel x:Name="pnlBereaved" Visibility="Collapsed">
                        <TextBlock Text="BEREAVED" FontSize="16" FontWeight="Bold"
                                   Foreground="#111827" Margin="0,0,0,10"/>
                        <Border Background="White" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="12">
                            <DataGrid x:Name="dgBereaved" Style="{StaticResource GridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NO"           Binding="{Binding No}"           Width="50"/>
                                    <DataGridTextColumn Header="DATE"         Binding="{Binding Date}"         Width="90"/>
                                    <DataGridTextColumn Header="FIRST NAME"   Binding="{Binding FirstName}"    Width="*"/>
                                    <DataGridTextColumn Header="LAST NAME"    Binding="{Binding LastName}"     Width="*"/>
                                    <DataGridTextColumn Header="BRGY"         Binding="{Binding Brgy}"         Width="70"/>
                                    <DataGridTextColumn Header="RECIPIENT"    Binding="{Binding RecipientName}" Width="160"/>
                                    <DataGridTextColumn Header="RELATIONSHIP" Binding="{Binding Relationship}" Width="120"/>
                                    <DataGridTextColumn Header="AMOUNT"       Binding="{Binding Amount}"       Width="90"/>
                                    <DataGridTextColumn Header="REMARKS"      Binding="{Binding Remarks}"      Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="0,0,10,10" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total" FontWeight="Bold" Foreground="#111827" Width="700"/>
                                <TextBlock x:Name="txtBereavedTotal" FontWeight="Bold" Foreground="#111827" FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PREPARED BY:" Style="{StaticResource SigLabelStyle}"/>
                                    <TextBlock x:Name="TxtBereavedSigPreparedName" Style="{StaticResource SigNameStyle}"/>
                                    <TextBlock Text="ENCODER" Style="{StaticResource SigTitleStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="NOTED BY:" Style="{StaticResource SigLabelStyle}"/>
                                    <TextBlock Text="DAISY JANE R. ACERO, RSW"
                                               Style="{StaticResource SigNameStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="SWO-III/ SC-Focal Person"
                                               Style="{StaticResource SigTitleStyle}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

     
            <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0" Padding="28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <TextBlock x:Name="TxtExportStatus" Text="Ready to export"
                                       FontSize="11" Foreground="#374151"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EXPORT" VerticalAlignment="Center" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,14,0"/>
                        <Button Content="📄  PDF" Style="{StaticResource ExportPdfStyle}" Click="BtnExportPdf_Click"/>
                        <Button Content="📊  CSV" Style="{StaticResource ExportCsvStyle}" Click="BtnExportCsv_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
